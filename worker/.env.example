# 本地环境变量参考（用于本地开发 / wrangler dev）
# 不要将任何 Secret 提交到仓库。

# 仅本地 wrangler dev 使用；生产部署请在 Cloudflare 控制台或
# `wrangler secret put <NAME>` 中配置（不要放这里，除非是本地开发）。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/db?sslmode=require
DEEPSEEK_API_KEY=your_deepseek_api_key
# 用于引导创建用户（POST /api/users 需要 x-admin-token 请求头）
ADMIN_TOKEN=generate_a_long_random_string
ALLOWED_ORIGIN=http://localhost:5173

# Hugging Face 免费沙箱
HF_SANDBOX_URL=https://LegspCpd-dsh-sandbox.hf.space
HF_SANDBOX_SECRET=your_hf_sandbox_secret
