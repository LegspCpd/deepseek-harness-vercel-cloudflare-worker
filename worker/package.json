{
  "name": "@deepseek-ai/dsh-serverless-worker",
  "description": "Cloudflare Workers engine for the Serverless DeepSeek Harness: Hono routing, SSE streaming, Drizzle/Neon persistence, and E2B sandbox forwarding with per-user data isolation.",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.44.4",
    "e2b": "2.29.1",
    "hono": "^4.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250401.0",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
